{
  "name": "lx-quality-tester",
  "version": "1.0.0",
  "description": "LX Music source quality tester",
  "main": "main/index.js",
  "author": "lx-tester",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "axios": "^1.6.0"
  },
  "build": {
    "appId": "com.lx.quality.tester",
    "productName": "LX-Quality-Tester",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "LX-Quality-Tester-${version}.exe"
    }
  }
}
